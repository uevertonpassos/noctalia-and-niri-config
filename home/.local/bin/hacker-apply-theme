#!/usr/bin/env sh
# Applied once at login so a restore from a TTY also gets the desktop theme.
set -eu
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3
    gsettings set org.gnome.desktop.interface icon-theme Hacker-Neon
    gsettings set org.gnome.desktop.interface cursor-theme Hacker-Neon-Cursors
    gsettings set org.gnome.desktop.interface cursor-size 24
fi
